# =============================================================================
# Import ERP — environment template
#
# Copy to .env and fill in. Values shown here are the DEVELOPMENT defaults;
# every line marked [PROD] must be changed before the system faces the internet.
# See docs/08-DEPLOYMENT.md for the full server build.
# =============================================================================

APP_NAME="Import ERP"
APP_ENV=local                          # [PROD] production
APP_KEY=                               # php artisan key:generate
APP_DEBUG=true                         # [PROD] false — leaking stack traces exposes cost data
APP_URL=http://localhost:8000          # [PROD] https://erp.yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=UTC                       # [PROD] set to your operating timezone, e.g. Asia/Baghdad
                                       # Alerts run at 07:00 and the KPI snapshot at 00:20 in THIS zone.

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# --- Logging -----------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single                       # [PROD] daily — single grows without bound
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug                        # [PROD] warning

# --- Database ----------------------------------------------------------------
# SQLite is fine for development. Production uses PostgreSQL: this system holds
# an append-only stock ledger and cash ledger, and SQLite's single-writer lock
# will serialise every receipt, invoice and payment under concurrent use.
DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql                  # [PROD]
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=erp
# DB_USERNAME=erp
# DB_PASSWORD=

# --- Sessions, cache, queue --------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false            # [PROD] true — requires HTTPS
SESSION_SAME_SITE=lax

CACHE_STORE=database                   # [PROD] redis if available; see the note in docs/08
QUEUE_CONNECTION=database              # PDF rendering and imports are synchronous today,
                                       # but keep a worker running — see docs/08-DEPLOYMENT.md
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail --------------------------------------------------------------------
# Used for password resets. Alerts are delivered in-panel, not by email.
MAIL_MAILER=log                        # [PROD] smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="erp@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- PDF rendering -----------------------------------------------------------
# Invoices and delivery notes render through headless Chromium, which is what
# makes the Arabic/Kurdish RTL columns lay out correctly. Without a browser the
# PDF actions fail — nothing else does.
# Leave empty to auto-detect; set explicitly on a server.
CHROME_PATH=
# CHROME_PATH=/usr/bin/chromium        # [PROD] Debian/Ubuntu

# --- AI assistant ------------------------------------------------------------
# Optional. Without a key the Ask page explains it is unconfigured and every
# other module works normally.
# The assistant is read-only and cost figures are withheld from users who lack
# the `view_cost` permission — see app/Services/Ai/ErpToolSurface.php.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Backups (spatie/laravel-backup) -----------------------------------------
BACKUP_DISK=local                      # [PROD] point at off-server storage; see docs/08
BACKUP_NOTIFICATION_EMAIL=

VITE_APP_NAME="${APP_NAME}"
